; SimLitic – Godot 4 project
config_version=5

[application]

config/name="SimLitic"
config/description="Steinzeit-Aufbauspiel: Vom Sammler zum Bauern in den Tälern der Ersten."
config/version="0.3.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/buildings/tent.png"
boot_splash/bg_color=Color(0.16, 0.12, 0.09, 1)
boot_splash/show_image=false

[autoload]

Content="*res://scripts/core/content.gd"
Settings="*res://scripts/core/settings.gd"
Sfx="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.917, 0.862, 0.725, 1)
